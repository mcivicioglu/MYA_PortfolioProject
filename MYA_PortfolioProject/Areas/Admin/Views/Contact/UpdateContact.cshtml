@model Contact
@{
    ViewData["Title"] = "İletişim Bilgileri";
}
<form asp-action="UpdateContact" method="post">
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="ad-card">
                <div class="ad-card-head">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ad-head-ico"><i class="bi bi-geo-alt"></i></div>
                        <div><h2>İletişim Bölümü</h2><p>Sitenin en altındaki iletişim alanında görünen bilgiler.</p></div>
                    </div>
                    <a asp-controller="Social" asp-action="SocialList" class="ad-btn-light ad-btn-sm"><i class="bi bi-share"></i> Sosyal Medya</a>
                </div>
                <div asp-validation-summary="ModelOnly"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label">Başlık</label>
                        <input asp-for="Title" class="form-control" placeholder="Harika Bir Fikrin mi Var? Birlikte Hayata Geçirelim.">
                        <span asp-validation-for="Title"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">E-posta</label>
                        <input asp-for="Email" class="form-control" type="email">
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">Telefon <span class="text-muted fw-normal">(isteğe bağlı)</span></label>
                        <input asp-for="PhoneNumber" class="form-control" type="tel">
                        <span asp-validation-for="PhoneNumber"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Location" class="form-label">Konum</label>
                        <input asp-for="Location" class="form-control" placeholder="İzmir, Türkiye">
                        <span asp-validation-for="Location"></span>
                    </div>
                </div>
                <div class="ad-form-foot">
                    <button type="submit" class="ad-btn"><i class="bi bi-check2"></i> Kaydet</button>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="ad-card">
                <div class="ad-section-title">Bilgi</div>
                <p class="small text-muted mb-0">Ziyaretçilerin iletişim formundan gönderdiği mesajlar <a asp-controller="Message" asp-action="MessageList">Gelen Mesajlar</a> sayfasında listelenir.</p>
            </div>
        </div>
    </div>
</form>
