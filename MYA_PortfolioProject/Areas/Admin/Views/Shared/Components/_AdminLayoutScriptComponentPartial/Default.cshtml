<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    (function () {
        // Mobil sidebar
        var sidebar = document.getElementById('adSidebar'),
            backdrop = document.getElementById('adBackdrop'),
            toggle = document.getElementById('adSidebarToggle');

        function setSidebar(open) {
            sidebar.classList.toggle('open', open);
            backdrop.classList.toggle('show', open);
            if (toggle) toggle.setAttribute('aria-expanded', open);
        }
        if (toggle) toggle.addEventListener('click', function () { setSidebar(!sidebar.classList.contains('open')); });
        backdrop.addEventListener('click', function () { setSidebar(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setSidebar(false); });

        // Bildirim birkaç saniye sonra kaybolur
        var toast = document.getElementById('adToast');
        if (toast) setTimeout(function () { toast.remove(); }, 4500);

        // Silme onayı: <button class="js-delete" data-name="..."> bir <form> içinde olmalı
        var modalEl = document.getElementById('deleteModal');
        var modal = new bootstrap.Modal(modalEl);
        var pendingForm = null;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.js-delete');
            if (!btn) return;
            e.preventDefault();
            pendingForm = btn.closest('form');
            var name = btn.dataset.name || 'Bu kayıt';
            document.getElementById('deleteModalText').textContent =
                '"' + name + '" kalıcı olarak silinecek.' + (btn.dataset.extra ? ' ' + btn.dataset.extra : '');
            modal.show();
        });
        document.getElementById('deleteModalConfirm').addEventListener('click', function () {
            if (pendingForm) pendingForm.submit();
        });

        // Dosya seçilince önizleme
        document.querySelectorAll('[data-file-input]').forEach(function (input) {
            input.addEventListener('change', function () {
                var box = document.getElementById(input.dataset.fileInput);
                var file = input.files[0];
                if (!box || !file) return;
                if (file.type.indexOf('image/') === 0) {
                    box.innerHTML = '';
                    var img = document.createElement('img');
                    img.alt = 'Seçilen görsel önizleme';
                    img.src = URL.createObjectURL(file);
                    box.appendChild(img);
                } else {
                    box.innerHTML = '<i class="bi bi-file-earmark-pdf"></i>';
                }
                var remove = document.querySelector('[data-remove-for="' + input.name + '"]');
                if (remove) remove.checked = false;
            });
        });

        // Bootstrap Icons sınıfı yazıldıkça önizleme
        document.querySelectorAll('[data-icon-input]').forEach(function (input) {
            var preview = document.getElementById(input.dataset.iconInput);
            function update() {
                var v = input.value.trim().replace(/^bi\s+/, '');
                if (v && v.indexOf('bi-') !== 0) v = 'bi-' + v;
                preview.innerHTML = '';
                var i = document.createElement('i');
                i.className = 'bi ' + (v || 'bi-question-lg');
                preview.appendChild(i);
            }
            input.addEventListener('input', update);
            update();
        });
    })();
</script>
