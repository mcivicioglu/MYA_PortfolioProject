<style>
    /* Sitenin renk ve yazı tipi sistemiyle aynı tokenlar */
    :root {
        --bg: #F7F5F0; --bg-2: #EBE7DF; --ink: #292D2B; --ink-2: #353A37; --muted: #6B6F6A;
        --sage: #91A99B; --sage-d: #5E7A6C; --sage-soft: rgba(145,169,155,.18);
        --terra: #C58D79; --terra-d: #9C5F4B; --terra-soft: rgba(197,141,121,.16);
        --danger: #A04435; --danger-soft: rgba(181,89,74,.12);
        --card: #FFFEFB; --line: rgba(41,45,43,.1);
        --r-s: 12px; --r-m: 20px; --r-l: 28px;
        --f-head: "Plus Jakarta Sans", system-ui, sans-serif; --f-body: "DM Sans", system-ui, sans-serif;
        --side-w: 272px; --top-h: 84px;
    }

    body { background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: .97rem; line-height: 1.6; }
    h1, h2, h3, h4, h5, h6 { font-family: var(--f-head); letter-spacing: -.02em; font-weight: 700; }
    a { color: inherit; }
    :focus-visible { outline: 3px solid var(--terra); outline-offset: 2px; border-radius: 6px; }
    .min-w-0 { min-width: 0; }

    /* ---------- Yerleşim ---------- */
    .ad-wrapper { display: flex; min-height: 100vh; }
    .ad-main { flex: 1; min-width: 0; margin-left: var(--side-w); display: flex; flex-direction: column; }
    .ad-content { padding: 1.75rem clamp(1rem, 3vw, 2.25rem) 3rem; }

    /* ---------- Sidebar ---------- */
    .ad-sidebar { position: fixed; inset: 0 auto 0 0; width: var(--side-w); background: var(--ink); color: rgba(247,245,240,.72); display: flex; flex-direction: column; z-index: 1040; transition: transform .3s ease; }
    .ad-brand { display: flex; align-items: center; gap: .85rem; padding: 1.5rem 1.4rem 1.25rem; border-bottom: 1px solid rgba(247,245,240,.08); }
    .ad-brand-mark { width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(160deg, #cfdcd3, var(--sage)); color: var(--ink); display: grid; place-items: center; font: 800 1rem var(--f-head); flex-shrink: 0; }
    .ad-brand-text { min-width: 0; line-height: 1.25; }
    .ad-brand-text strong { display: block; color: var(--bg); font: 800 1rem var(--f-head); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ad-brand-text strong span { color: var(--terra); }
    .ad-brand-text small { font-size: .78rem; color: rgba(247,245,240,.5); }
    .ad-nav { flex: 1; overflow-y: auto; padding: .6rem .85rem 1rem; }
    .ad-nav ul { list-style: none; margin: 0; padding: 0; }
    .ad-nav-label { font: 700 .7rem var(--f-head); letter-spacing: .14em; text-transform: uppercase; color: rgba(247,245,240,.38); padding: 1.1rem .75rem .45rem; }
    .ad-link { display: flex; align-items: center; gap: .8rem; padding: .62rem .8rem; border-radius: var(--r-s); text-decoration: none; font-weight: 500; font-size: .93rem; position: relative; transition: background .2s, color .2s; }
    .ad-link i { font-size: 1.05rem; width: 1.2rem; text-align: center; }
    .ad-link:hover { background: rgba(247,245,240,.06); color: var(--bg); }
    .ad-link.active { background: var(--sage-soft); color: #fff; }
    .ad-link.active::before { content: ""; position: absolute; left: -.85rem; top: 22%; bottom: 22%; width: 3px; border-radius: 0 3px 3px 0; background: var(--terra); }
    .ad-count { margin-left: auto; min-width: 22px; height: 22px; padding: 0 .4rem; border-radius: 999px; background: var(--terra); color: #fff; font: 700 .72rem/22px var(--f-head); text-align: center; }
    .ad-sidebar-foot { padding: .85rem; border-top: 1px solid rgba(247,245,240,.08); }
    .ad-backdrop { display: none; }

    /* ---------- Üst bar ---------- */
    .ad-topbar { position: sticky; top: 0; z-index: 1030; min-height: var(--top-h); display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem clamp(1rem, 3vw, 2.25rem); background: rgba(247,245,240,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
    .ad-crumb { font-size: .8rem; color: var(--muted); display: flex; gap: .4rem; }
    .ad-crumb a { text-decoration: none; }
    .ad-crumb a:hover { color: var(--ink); }
    .ad-page-title { font-size: clamp(1.25rem, 2.4vw, 1.6rem); margin: .1rem 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ad-dot { position: absolute; top: 9px; right: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--terra); box-shadow: 0 0 0 2px var(--bg); }

    @@media (max-width: 1199.98px) {
        .ad-main { margin-left: 0; }
        .ad-sidebar { transform: translateX(-100%); }
        .ad-sidebar.open { transform: none; box-shadow: 0 0 40px rgba(0,0,0,.25); }
        .ad-backdrop.show { display: block; position: fixed; inset: 0; background: rgba(41,45,43,.4); z-index: 1035; }
    }

    /* ---------- Butonlar ---------- */
    .ad-btn, .ad-btn-light { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; font: 600 .88rem var(--f-head); border-radius: 999px; padding: .62rem 1.3rem; text-decoration: none; border: 1.5px solid var(--ink); transition: background .2s, color .2s, border-color .2s, transform .2s; cursor: pointer; white-space: nowrap; }
    .ad-btn { background: var(--ink); color: var(--bg); }
    .ad-btn:hover { background: var(--sage-d); border-color: var(--sage-d); color: #fff; transform: translateY(-1px); }
    .ad-btn.danger { background: var(--danger); border-color: var(--danger); color: #fff; }
    .ad-btn.danger:hover { background: #82352a; border-color: #82352a; }
    .ad-btn-light { background: transparent; color: var(--ink); border-color: var(--line); }
    .ad-btn-light:hover { border-color: var(--ink); color: var(--ink); }
    .ad-btn-sm { padding: .42rem .95rem; font-size: .8rem; }
    .ad-icon-btn { width: 40px; height: 40px; display: inline-grid; place-items: center; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--ink); text-decoration: none; font-size: 1.05rem; transition: background .2s, color .2s, border-color .2s; cursor: pointer; }
    .ad-icon-btn:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .ad-icon-btn.danger:hover { background: var(--danger); border-color: var(--danger); color: #fff; }
    .ad-icon-btn.sm { width: 34px; height: 34px; font-size: .92rem; border-radius: 10px; }

    /* ---------- Kartlar ---------- */
    .ad-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-m); padding: clamp(1.15rem, 2.5vw, 1.75rem); }
    .ad-card + .ad-card { margin-top: 1.5rem; }
    .ad-card-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
    .ad-card-head h2 { font-size: 1.15rem; margin: 0; }
    .ad-card-head p { margin: .15rem 0 0; color: var(--muted); font-size: .88rem; }
    .ad-head-ico { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; font-size: 1.2rem; background: var(--sage-soft); color: var(--sage-d); flex-shrink: 0; }
    .ad-head-ico.terra { background: var(--terra-soft); color: var(--terra-d); }
    .ad-section-title { font: 700 .72rem var(--f-head); letter-spacing: .14em; text-transform: uppercase; color: var(--terra-d); margin-bottom: 1rem; display: flex; align-items: center; gap: .6rem; }
    .ad-section-title::before { content: ""; width: 20px; height: 2px; background: var(--terra); }

    /* ---------- İstatistik kartları ---------- */
    .ad-stat { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-m); padding: 1.3rem 1.4rem; height: 100%; display: flex; gap: 1rem; align-items: flex-start; text-decoration: none; transition: transform .25s, box-shadow .25s; }
    .ad-stat:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(41,45,43,.07); }
    .ad-stat b { display: block; font: 800 2rem/1 var(--f-head); letter-spacing: -.04em; margin-bottom: .3rem; }
    .ad-stat span { color: var(--muted); font-size: .86rem; }
    .ad-stat small { display: block; margin-top: .35rem; font-size: .78rem; color: var(--sage-d); font-weight: 600; }
    .ad-stat.dark { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .ad-stat.dark span { color: rgba(247,245,240,.65); }
    .ad-stat.dark small { color: var(--terra); }
    .ad-stat.dark .ad-head-ico { background: rgba(247,245,240,.1); color: var(--bg); }

    /* ---------- Tablolar ---------- */
    .ad-table { margin: 0; --bs-table-bg: transparent; }
    .ad-table thead th { font: 700 .72rem var(--f-head); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); padding: .7rem .75rem; white-space: nowrap; }
    .ad-table tbody td { border-bottom: 1px solid var(--line); padding: .85rem .75rem; vertical-align: middle; }
    .ad-table tbody tr:last-child td { border-bottom: 0; }
    .ad-table tbody tr:hover td { background: rgba(235,231,223,.45); }
    .ad-table tr.unread td { font-weight: 600; }
    .ad-actions { display: flex; justify-content: flex-end; gap: .4rem; }
    .ad-thumb { width: 64px; height: 44px; border-radius: 10px; object-fit: cover; background: var(--bg-2); display: grid; place-items: center; color: var(--muted); }
    .ad-badge { display: inline-flex; align-items: center; gap: .35rem; font: 600 .76rem var(--f-head); padding: .28rem .75rem; border-radius: 999px; border: 0; white-space: nowrap; }
    .ad-badge.on { background: var(--sage-soft); color: var(--sage-d); }
    .ad-badge.off { background: var(--bg-2); color: var(--muted); }
    .ad-badge.terra { background: var(--terra-soft); color: var(--terra-d); }
    button.ad-badge { cursor: pointer; }
    button.ad-badge:hover { filter: brightness(.95); }
    .ad-tag { display: inline-block; font-size: .76rem; padding: .15rem .6rem; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); margin: 0 .25rem .25rem 0; }
    .ad-empty { text-align: center; color: var(--muted); padding: 3rem 1rem; }
    .ad-empty i { font-size: 2rem; display: block; margin-bottom: .6rem; opacity: .5; }

    /* ---------- Formlar ---------- */
    .form-label { font-weight: 600; font-size: .87rem; margin-bottom: .4rem; }
    .form-control, .form-select { background-color: var(--bg); border: 1px solid var(--line); border-radius: var(--r-s); padding: .72rem .95rem; font-size: .95rem; color: var(--ink); }
    .form-control:focus, .form-select:focus { background-color: #fff; border-color: var(--sage-d); box-shadow: 0 0 0 4px rgba(145,169,155,.28); }
    .form-control.input-validation-error, .form-select.input-validation-error { border-color: #B5594A; }
    textarea.form-control { min-height: 130px; }
    .field-validation-error, .text-danger { color: var(--danger) !important; font-size: .82rem; }
    .validation-summary-errors ul { margin: 0; padding-left: 1.1rem; }
    .validation-summary-errors { background: var(--danger-soft); color: var(--danger); border-radius: var(--r-s); padding: .8rem 1rem; margin-bottom: 1.2rem; font-size: .88rem; }
    .form-text { color: var(--muted); font-size: .8rem; }
    .form-check-input:checked { background-color: var(--sage-d); border-color: var(--sage-d); }
    .form-check-input:focus { box-shadow: 0 0 0 4px rgba(145,169,155,.28); border-color: var(--sage-d); }
    .ad-switch { display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--r-s); padding: .75rem 1rem; }
    .ad-switch .form-check-input { width: 2.6em; height: 1.4em; margin: 0; cursor: pointer; }
    .ad-form-foot { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: flex-end; border-top: 1px solid var(--line); margin-top: 1.5rem; padding-top: 1.25rem; }

    /* Dosya yükleme alanı */
    .ad-file { border: 1.5px dashed rgba(41,45,43,.2); border-radius: var(--r-m); background: var(--bg); padding: 1rem; }
    .ad-file-preview { aspect-ratio: 16/10; border-radius: var(--r-s); background: var(--bg-2); overflow: hidden; display: grid; place-items: center; color: var(--muted); margin-bottom: .9rem; }
    .ad-file-preview.portrait { aspect-ratio: 4/5; max-width: 260px; margin-inline: auto; }
    .ad-file-preview img { width: 100%; height: 100%; object-fit: cover; }
    .ad-file-preview i { font-size: 2rem; opacity: .55; }
    .ad-file-doc { display: flex; align-items: center; gap: .7rem; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-s); padding: .7rem .9rem; margin-bottom: .9rem; text-decoration: none; font-size: .88rem; }
    .ad-file-doc i { font-size: 1.4rem; color: var(--terra-d); }
    .ad-file .form-control { background-color: var(--card); }

    /* İkon önizleme (Bootstrap Icons sınıfı) */
    .ad-icon-preview { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; font-size: 1.3rem; background: var(--sage-soft); color: var(--sage-d); flex-shrink: 0; }

    /* ---------- Dashboard ---------- */
    .ad-hello { background: var(--ink); color: var(--bg); border-radius: var(--r-l); padding: clamp(1.5rem, 3.5vw, 2.4rem); position: relative; overflow: hidden; }
    .ad-hello::after { content: ""; position: absolute; right: -40px; top: -60px; width: 220px; height: 220px; border-radius: 50%; background: var(--sage); opacity: .22; }
    .ad-hello::before { content: ""; position: absolute; right: 120px; bottom: -50px; width: 110px; height: 110px; border-radius: 50%; background: var(--terra); opacity: .3; }
    .ad-hello h2 { font-size: clamp(1.4rem, 3vw, 2rem); margin: .35rem 0 .5rem; position: relative; z-index: 1; }
    .ad-hello p { color: rgba(247,245,240,.7); margin: 0 0 1.2rem; max-width: 52ch; position: relative; z-index: 1; }
    .ad-hello .eyebrow { font: 700 .72rem var(--f-head); letter-spacing: .14em; color: var(--terra); position: relative; z-index: 1; }
    .ad-hello .ad-btn { background: var(--bg); color: var(--ink); border-color: var(--bg); position: relative; z-index: 1; }
    .ad-hello .ad-btn:hover { background: var(--sage); border-color: var(--sage); color: var(--ink); }
    .ad-hello .ad-btn-light { color: var(--bg); border-color: rgba(247,245,240,.3); position: relative; z-index: 1; }
    .ad-hello .ad-btn-light:hover { border-color: var(--bg); color: var(--bg); }
    .ad-bars { display: flex; align-items: flex-end; gap: .6rem; height: 170px; padding-top: .5rem; }
    .ad-bar { flex: 1; display: flex; flex-direction: column; align-items: center; gap: .4rem; height: 100%; justify-content: flex-end; }
    .ad-bar-fill { width: 100%; max-width: 38px; border-radius: 10px 10px 4px 4px; background: var(--sage); min-height: 4px; transition: height .6s ease; }
    .ad-bar.today .ad-bar-fill { background: var(--terra); }
    .ad-bar b { font: 700 .78rem var(--f-head); }
    .ad-bar small { font-size: .74rem; color: var(--muted); }
    .ad-progress { height: 8px; border-radius: 999px; background: var(--bg-2); overflow: hidden; }
    .ad-progress span { display: block; height: 100%; border-radius: inherit; background: var(--sage-d); }
    .ad-list { list-style: none; margin: 0; padding: 0; }
    .ad-list li { display: flex; align-items: center; gap: .9rem; padding: .8rem 0; border-bottom: 1px solid var(--line); }
    .ad-list li:last-child { border-bottom: 0; }
    .ad-avatar { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font: 700 .85rem var(--f-head); background: var(--terra-soft); color: var(--terra-d); flex-shrink: 0; }
    .ad-list .meta { min-width: 0; flex: 1; }
    .ad-list .meta strong { display: block; font-size: .92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ad-list .meta span { display: block; font-size: .82rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ad-quick { display: grid; grid-template-columns: repeat(2, 1fr); gap: .6rem; }
    .ad-quick a { display: flex; align-items: center; gap: .6rem; padding: .75rem .9rem; border-radius: var(--r-s); border: 1px solid var(--line); background: var(--bg); text-decoration: none; font-weight: 500; font-size: .88rem; transition: border-color .2s, background .2s; }
    .ad-quick a:hover { border-color: var(--ink); background: var(--card); }
    .ad-quick i { color: var(--sage-d); }

    /* ---------- Mesajlar ---------- */
    .ad-tabs { display: flex; flex-wrap: wrap; gap: .4rem; }
    .ad-tabs a { font: 600 .84rem var(--f-head); padding: .45rem 1rem; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); text-decoration: none; }
    .ad-tabs a:hover { color: var(--ink); border-color: var(--ink); }
    .ad-tabs a.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .ad-msg-body { white-space: pre-wrap; background: var(--bg); border: 1px solid var(--line); border-radius: var(--r-s); padding: 1rem 1.1rem; }

    /* ---------- Toast ve modal ---------- */
    .ad-toast { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 1090; display: flex; align-items: center; gap: .7rem; max-width: min(420px, calc(100vw - 2.5rem)); background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--sage-d); border-radius: var(--r-s); padding: .85rem 1rem; box-shadow: 0 16px 36px rgba(41,45,43,.14); font-size: .9rem; animation: ad-toast-in .35s ease; }
    .ad-toast.err { border-left-color: var(--danger); }
    .ad-toast i.bi-check-circle-fill { color: var(--sage-d); font-size: 1.15rem; }
    .ad-toast i.bi-exclamation-circle-fill { color: var(--danger); font-size: 1.15rem; }
    .ad-toast button { border: 0; background: transparent; color: var(--muted); margin-left: auto; font-size: 1.1rem; line-height: 1; }
    @@keyframes ad-toast-in { from { opacity: 0; transform: translateY(12px); } }
    .ad-modal { border: 0; border-radius: var(--r-l); background: var(--card); }
    .ad-modal-ico { width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 1rem; display: grid; place-items: center; font-size: 1.4rem; background: var(--danger-soft); color: var(--danger); }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition-duration: .01ms !important; }
    }
</style>
