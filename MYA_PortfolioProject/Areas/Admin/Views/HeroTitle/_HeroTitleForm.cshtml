@model HeroTitle
@{
    var action = ViewData["FormAction"] as string ?? "CreateHeroTitle";
}
<form asp-action="@action" method="post">
    <input type="hidden" asp-for="HeroTitleId">
    <div class="ad-card" style="max-width: 760px;">
        <div class="ad-card-head">
            <div class="d-flex align-items-center gap-3">
                <div class="ad-head-ico"><i class="bi bi-type"></i></div>
                <div><h2>@ViewData["FormTitle"]</h2><p>Örn: “ASP.NET Core Geliştiricisi”</p></div>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label">Unvan</label>
                <input asp-for="Title" class="form-control">
                <span asp-validation-for="Title"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Order" class="form-label">Sıra</label>
                <input asp-for="Order" class="form-control" min="1" max="100">
                <span asp-validation-for="Order"></span>
            </div>
            <div class="col-12">
                <label class="ad-switch" for="IsActive">
                    <span>Animasyonda göster</span>
                    <input asp-for="IsActive" class="form-check-input" role="switch">
                </label>
            </div>
        </div>
        <div class="ad-form-foot">
            <a asp-action="HeroTitleList" class="ad-btn-light">Vazgeç</a>
            <button type="submit" class="ad-btn"><i class="bi bi-check2"></i> Kaydet</button>
        </div>
    </div>
</form>
