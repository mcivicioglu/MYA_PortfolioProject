@model About?
@{
    var nameSurname = Model?.NameSurname ?? "Mahmut Çivicioğlu";
    var description = Model?.Description ?? "Merhaba, ben Mahmut Çivicioğlu. C#, ASP.NET Core, HTML5, CSS3 ve modern yazılım geliştirme pratikleri üzerine çalışan, sürekli öğrenen ve üreten bir geliştiriciyim.";
    var paragraphs = description.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
<section id="about" class="section section-alt">
    <div class="container">
        <div class="row align-items-center gy-5 gx-xl-6">
            <div class="col-lg-5 reveal">
                <div class="about-img">
                    @if (!string.IsNullOrWhiteSpace(Model?.MainImageUrl))
                    {
                        <img src="@Model.MainImageUrl" alt="@nameSurname portre" class="w-100 object-fit-cover" style="aspect-ratio:4/5;border-radius:var(--r-l) var(--r-l) 160px var(--r-l);">
                    }
                    else
                    {
                        <div class="frame" role="img" aria-label="@nameSurname portre">@nameSurname[0]</div>
                    }
                </div>
            </div>
            <div class="col-lg-7 reveal">
                <span class="eyebrow">BENİ TANIYIN</span>
                <h2 class="title mb-4">@(Model?.Title ?? "Teknolojiye Tutkuyla Bağlı Bir Yolculuk.")</h2>
                @foreach (var paragraph in paragraphs)
                {
                    <p>@paragraph</p>
                }
                <div class="stats">
                    <div class="stat"><b>.NET</b><span>Core &amp; MVC</span></div>
                    <div class="stat"><b>Web</b><span>HTML5 &amp; CSS3</span></div>
                    <div class="stat"><b>SQL</b><span>Veritabanı</span></div>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model?.AboutCVUrl))
                    {
                        <a href="@Model.AboutCVUrl" target="_blank" rel="noopener noreferrer" class="btn-pill btn-dark-p text-decoration-none">Özgeçmişimi İncele</a>
                        <a href="#contact" class="btn-pill btn-line text-decoration-none">İletişime Geç</a>
                    }
                    else
                    {
                        <a href="#contact" class="btn-pill btn-dark-p text-decoration-none">İletişime Geç</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
