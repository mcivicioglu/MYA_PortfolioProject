@model List<Certificate>

@if (Model != null && Model.Any())
{
    <section id="certificates" class="section">
        <div class="container">
            <div class="reveal">
                <span class="eyebrow">SERTİFİKALAR &amp; KURSLAR</span>
                <h2 class="title mb-3">Aldığım Eğitimler ve Belgeler</h2>
                <p class="lead-s">Yazılım geliştirme ve teknik yetkinliklerimi pekiştirmek için tamamladığım eğitim programları.</p>
            </div>

            <div class="row g-4 mt-3">
                @foreach (var cert in Model)
                {
                    <div class="col-md-6 reveal">
                        <article class="t-card h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <h3 class="mb-0">@cert.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(cert.Date))
                                    {
                                        <span class="t-date m-0 flex-shrink-0">@cert.Date</span>
                                    }
                                </div>
                                <div class="t-org">@cert.Institution</div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(cert.CertificateUrl))
                            {
                                <div class="mt-3 pt-2 border-top d-flex justify-content-end">
                                    <a href="@cert.CertificateUrl" target="_blank" rel="noopener noreferrer" class="btn-pill btn-line btn-sm-p text-decoration-none">
                                        Belgeyi Görüntüle <i class="bi bi-arrow-up-right ms-1"></i>
                                    </a>
                                </div>
                            }
                        </article>
                    </div>
                }
            </div>
        </div>
    </section>
}