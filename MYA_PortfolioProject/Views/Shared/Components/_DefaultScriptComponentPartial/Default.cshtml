<!-- Bootstrap 5 Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Nav, scroll ve reveal -->
<script>
    (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

        var nav = document.getElementById('nav'),
            burger = document.getElementById('burger'),
            wrap = document.getElementById('navWrap'),
            toTop = document.getElementById('toTop');

        function onScroll() {
            if (nav) nav.classList.toggle('scrolled', scrollY > 20);
            if (toTop) toTop.classList.toggle('show', scrollY > 700);
        }
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        function setMenu(open) {
            if (!wrap || !burger) return;
            wrap.classList.toggle('open', open);
            burger.classList.toggle('open', open);
            burger.setAttribute('aria-expanded', open);
        }

        if (burger && wrap) {
            burger.addEventListener('click', function () { setMenu(!wrap.classList.contains('open')); });
            wrap.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { setMenu(false); }); });
        }

        var links = document.querySelectorAll('.nav-links a');
        if (links.length && 'IntersectionObserver' in window) {
            var spy = new IntersectionObserver(function (es) {
                es.forEach(function (e) {
                    if (e.isIntersecting) {
                        links.forEach(function (l) { l.classList.toggle('active', l.getAttribute('href') === '#' + e.target.id); });
                    }
                });
            }, { rootMargin: '-45% 0px -50% 0px' });
            document.querySelectorAll('main section[id]').forEach(function (s) { spy.observe(s); });
        }

        if (toTop) {
            toTop.addEventListener('click', function () { scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }); });
        }

        var rev = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window && !reduce) {
            var io = new IntersectionObserver(function (es) {
                es.forEach(function (e) {
                    if (e.isIntersecting) {
                        e.target.classList.add('in');
                        io.unobserve(e.target);
                    }
                });
            }, { threshold: .12 });
            rev.forEach(function (r) { io.observe(r); });
        } else {
            rev.forEach(function (r) { r.classList.add('in'); });
        }
    })();
</script>
