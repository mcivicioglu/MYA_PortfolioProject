@model List<Skill>

<section id="skills" class="section">
    <div class="container">
        <div class="reveal">
            <span class="eyebrow">TEKNOLOJİ YIĞINIM</span>
            <h2 class="title mb-3">Kullandığım Teknolojiler ve Uzmanlık Alanlarım</h2>
            <p class="lead-s">Bir fikrin hayata geçirilmesinden ölçeklenebilir bir yazılım ürününe dönüşmesine kadar farklı teknolojilerle çalışıyorum.</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4 mt-3" id="skillGrid">
                @foreach (var skill in Model)
                {
                    var rawIcon = (skill.IconURL ?? string.Empty).Trim();
                    var iconClass = string.IsNullOrWhiteSpace(rawIcon)
                        ? "bi-code-slash"
                        : rawIcon.Replace("bi bi-", "").Replace("bi-", "").Trim();

                    <div class="col-md-6 col-xl-4 reveal">
                        <article class="skill-card">
                            <div class="skill-ico"><i class="bi bi-@iconClass"></i></div>
                            <h3>@skill.Title</h3>
                            <div class="tags">
                                @if (skill.SkillItems != null)
                                {
                                    foreach (var item in skill.SkillItems)
                                    {
                                        <span class="tag">@item.SkillItemTitle</span>
                                    }
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>