@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mahmut Çivicioğlu — Yazılım Geliştiricisi &amp; Eğitmen</title>
    <meta name="description" content="Mahmut Çivicioğlu kişisel portfolyo sitesi: .NET, yazılım mimarileri ve modern web çözümleri.">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @await Component.InvokeAsync("_DefaultStyleComponentPartial")
</head>
<body>

    <!-- Navigation -->
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")

    <main>
        <!-- Hero Section -->
        @await Component.InvokeAsync("_DefaultHeroSectionComponentPartial")

        <!-- About Me Section -->
        @await Component.InvokeAsync("_DefaultAboutComponentPartial")

        <!-- Skills Section -->
        @await Component.InvokeAsync("_DefaultSkillComponentPartial")

        <!-- Professional Experience Section -->
        @await Component.InvokeAsync("_DefaultExperienceComponentPartial")

        <!-- Featured Projects Section -->
        @await Component.InvokeAsync("_DefaultProjectComponentPartial")

        <!-- Education Section -->
        @await Component.InvokeAsync("_DefaultEducationComponentPartial")

        <!-- Certificate Section -->
        @await Component.InvokeAsync("_DefaultCertificateComponentPartial")

        <!-- Personal Philosophy Section -->
        <section class="philo" aria-label="Çalışma felsefem">
            <div class="container">
                <blockquote>İyi yazılım yalnızca çalışan kod değil, gerçek bir probleme üretilmiş anlamlı bir çözümdür.</blockquote>
            </div>
        </section>

        <!-- Contact Section -->
        @await Component.InvokeAsync("_DefaultContactComponentPartial")
    </main>

    <!-- Footer -->
    @await Component.InvokeAsync("_DefaultFooterComponentPartial")

    <button class="to-top" id="toTop" aria-label="Sayfa başına dön">
        <i class="bi bi-arrow-up"></i>
    </button>

    <!-- Scripts -->
    @await Component.InvokeAsync("_DefaultScriptComponentPartial")
</body>
</html>
